#!/usr/bin/env bash
# Print the path of a short H.264 + AAC test video, generating it with ffmpeg on first use.
# Set CLIP to use your own file instead.
set -euo pipefail
if [[ -n ${CLIP:-} ]]; then echo "$CLIP"; exit 0; fi
out=${XDG_CACHE_HOME:-$HOME/.cache}/omaplay-dev/test-1080p.mp4
if [[ ! -s $out ]]; then
  mkdir -p "${out%/*}"
  ffmpeg -v error -y -f lavfi -i "testsrc2=duration=30:size=1920x1080:rate=30" \
    -f lavfi -i "sine=frequency=440:duration=30" -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest "$out"
fi
echo "$out"
