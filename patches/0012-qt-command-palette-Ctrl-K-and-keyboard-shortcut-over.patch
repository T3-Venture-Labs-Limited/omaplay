+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+import QtQuick
+import QtQuick.Templates as T
+
+import VLC.MainInterface
+import VLC.Style
+import VLC.Dialogs
+import VLC.Widgets as Widgets
+
+// The command palette (Ctrl+K) and the keyboard shortcut overlay (?).
+//
+// Both list the same entries: dialogs and every hotkey action VLC knows, taken live from its key
+// configuration. The palette filters them by fuzzy search and runs the chosen one; the overlay only
+// shows the entries that have a key bound, so it always reflects the user's own bindings.
+FocusScope {
+    id: root
+
+    // "palette" or "shortcuts"
+    property string mode: "palette"
+    readonly property bool isPalette: mode === "palette"
+    property bool shown: false
+    property Item _restoreFocus: null
+
+    visible: opacity > 0
+    opacity: shown ? 1 : 0
+    z: 100
+
+    Behavior on opacity {
+        NumberAnimation { duration: VLCStyle.duration_short; easing.type: Easing.OutCubic }
+    }
+
+    function open(newMode) {
+        mode = newMode
+        field.text = ""
+        list.currentIndex = 0
+        _restoreFocus = Window.window ? Window.window.activeFocusItem : null
+        MainCtx.hotkeyActions.refresh()
+        shown = true
+        field.forceActiveFocus()
+    }
+
+    function toggle(newMode) {
+        if (shown && mode === newMode)
+            close()
+        else
+            open(newMode)
+    }
+
+    function close() {
+        shown = false
+        if (_restoreFocus)
+            _restoreFocus.forceActiveFocus()
+    }
+
+    function runEntry(entry) {
+        if (!entry || !isPalette)
+            return close()
+        // Close first so a dialog that opens gets the focus.
+        close()
+        if (entry.run)
+            entry.run()
+        else
+            MainCtx.hotkeyActions.run(entry.name)
+    }
+
+    // Dialogs and interface actions. Their shortcuts are VLC's fixed ones (see menus/qml/GlobalShortcuts.qml).
+    readonly property var staticActions: [
+        { title: qsTr("Preferences"), shortcut: "Ctrl+P", run: () => DialogsProvider.prefsDialog() },
+        { title: qsTr("Adjustments and effects"), shortcut: "Ctrl+E", run: () => DialogsProvider.extendedDialog() },
+        { title: qsTr("Subtitle synchronisation"), shortcut: "", run: () => DialogsProvider.synchroDialog() },
+        { title: qsTr("Audio synchronisation"), shortcut: "", run: () => DialogsProvider.synchroDialog() },
+        { title: qsTr("Media information"), shortcut: "Ctrl+I", run: () => DialogsProvider.mediaInfoDialog() },
+        { title: qsTr("Codec information"), shortcut: "Ctrl+J", run: () => DialogsProvider.mediaCodecDialog() },
+        { title: qsTr("Messages"), shortcut: "Ctrl+M", run: () => DialogsProvider.messagesDialog() },
+        { title: qsTr("Bookmarks"), shortcut: "", run: () => DialogsProvider.bookmarksDialog() },
+        { title: qsTr("Open file"), shortcut: "Ctrl+Shift+O", run: () => DialogsProvider.openFileDialog() },
+        { title: qsTr("Open directory"), shortcut: "Ctrl+F", run: () => DialogsProvider.PLOpenDir() },
+        { title: qsTr("Open disc"), shortcut: "Ctrl+D", run: () => DialogsProvider.openDiscDialog() },
+        { title: qsTr("Open network stream"), shortcut: "Ctrl+N", run: () => DialogsProvider.openNetDialog() },
+        { title: qsTr("Open capture device"), shortcut: "Ctrl+C", run: () => DialogsProvider.openCaptureDialog() },
+        { title: qsTr("Open location from clipboard"), shortcut: "", run: () => DialogsProvider.openUrlDialog() },
+        { title: qsTr("Convert / Save"), shortcut: "Ctrl+R", run: () => DialogsProvider.openAndTranscodingDialogs() },
+        { title: qsTr("Stream"), shortcut: "Ctrl+S", run: () => DialogsProvider.openAndStreamingDialogs() },
+        { title: qsTr("Go to time"), shortcut: "Ctrl+T", run: () => DialogsProvider.gotoTimeDialog() },
+        { title: qsTr("Plugins and extensions"), shortcut: "", run: () => DialogsProvider.pluginDialog() },
+        { title: qsTr("VLM configurator"), shortcut: "Ctrl+Shift+W", run: () => DialogsProvider.vlmDialog() },
+        { title: qsTr("Customize toolbar"), shortcut: "", run: () => DialogsProvider.showToolbarEditorDialog() },
+        { title: qsTr("Toggle play queue"), shortcut: "Ctrl+L", run: () => { MainCtx.playqueuePanel.visible = !MainCtx.playqueuePanel.visible } },
+        { title: qsTr("Toggle fullscreen interface"), shortcut: "F11", run: () => MainCtx.toggleInterfaceFullScreen() },
+        { title: qsTr("Help"), shortcut: "F1", run: () => DialogsProvider.helpDialog() },
+        { title: qsTr("About"), shortcut: "", run: () => DialogsProvider.aboutDialog() },
+        { title: qsTr("Quit"), shortcut: "Ctrl+Q", run: () => DialogsProvider.quit() }
+    ]
+
+    readonly property var entries: {
+        const list = staticActions.slice()
+        const hotkeys = MainCtx.hotkeyActions.actions
+        for (let i = 0; i < hotkeys.length; ++i)
+            list.push({ title: hotkeys[i].title, shortcut: hotkeys[i].shortcut, name: hotkeys[i].name })
+        return list
+    }
+
+    readonly property var results: {
+        const query = field.text
+        const scored = []
+        for (let i = 0; i < entries.length; ++i) {
+            const e = entries[i]
+            if (!isPalette && e.shortcut === "")
+                continue
+            const s = MainCtx.hotkeyActions.fuzzyScore(query, e.title)
+            if (s >= 0)
+                scored.push({ score: s, index: i, entry: e })
+        }
+        // Best first; equal scores keep their original order.
+        scored.sort((a, b) => b.score - a.score || a.index - b.index)
+        return scored.map(x => x.entry)
+    }
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        colorSet: ColorContext.Window
+    }
+
+    // Dim the interface behind the card; a click outside closes it.
+    Rectangle {
+        anchors.fill: parent
+        color: Qt.alpha(theme.bg.primary, 0.55)
+
+        MouseArea {
+            anchors.fill: parent
+            onClicked: root.close()
+        }
+    }
+
+    Rectangle {
+        id: card
+
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.top: parent.top
+        anchors.topMargin: Math.max(VLCStyle.margin_large, root.height * 0.12)
+
+        width: Math.min(VLCStyle.dp(640, VLCStyle.scale), root.width - VLCStyle.margin_large * 2)
+        height: Math.min(root.height - anchors.topMargin - VLCStyle.margin_large,
+                         header.height + list.contentHeight + VLCStyle.margin_normal * 3)
+
+        radius: VLCStyle.radiusFor(VLCStyle.dp(8, VLCStyle.scale), false)
+        color: theme.bg.primary
+        border.width: 1
+        border.color: theme.border
+
+        Column {
+            id: header
+
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.top: parent.top
+            anchors.margins: VLCStyle.margin_normal
+            spacing: VLCStyle.margin_xsmall
+
+            Text {
+                visible: !root.isPalette
+                width: parent.width
+                text: qsTr("Keyboard shortcuts")
+                textFormat: Text.PlainText
+                color: theme.fg.primary
+                font.pixelSize: VLCStyle.fontSize_large
+                font.bold: true
+            }
+
+            T.TextField {
+                id: field
+
+                width: parent.width
+                focus: true
+
+                placeholderText: root.isPalette ? qsTr("Type a command") : qsTr("Filter shortcuts")
+                color: theme.fg.primary
+                placeholderTextColor: theme.fg.secondary
+                font.pixelSize: VLCStyle.fontSize_large
+                selectByMouse: true
+                padding: VLCStyle.margin_xsmall
+
+                background: Rectangle {
+                    radius: VLCStyle.radiusFor(VLCStyle.dp(4, VLCStyle.scale), true)
+                    color: "transparent"
+                    border.width: 1
+                    border.color: field.activeFocus ? theme.accent : theme.border
+                }
+
+                onTextChanged: list.currentIndex = 0
+
+                Keys.onPressed: (event) => {
+                    switch (event.key) {
+                    case Qt.Key_Escape:
+                        root.close(); event.accepted = true; break
+                    case Qt.Key_Down:
+                        list.currentIndex = Math.min(list.count - 1, list.currentIndex + 1); event.accepted = true; break
+                    case Qt.Key_Up:
+                        list.currentIndex = Math.max(0, list.currentIndex - 1); event.accepted = true; break
+                    case Qt.Key_PageDown:
+                        list.currentIndex = Math.min(list.count - 1, list.currentIndex + 8); event.accepted = true; break
+                    case Qt.Key_PageUp:
+                        list.currentIndex = Math.max(0, list.currentIndex - 8); event.accepted = true; break
+                    case Qt.Key_Return:
+                    case Qt.Key_Enter:
+                        root.runEntry(root.results[list.currentIndex]); event.accepted = true; break
+                    }
+                }
+            }
+        }
+
+        ListView {
+            id: list
+
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.top: header.bottom
+            anchors.bottom: parent.bottom
+            anchors.margins: VLCStyle.margin_normal
+            anchors.topMargin: VLCStyle.margin_xsmall
+
+            clip: true
+            model: root.results
+            currentIndex: 0
+            boundsBehavior: Flickable.StopAtBounds
+            highlightMoveDuration: 0
+
+            delegate: Rectangle {
+                id: row
+
+                required property var modelData
+                required property int index
+
+                width: ListView.view.width
+                height: Math.max(VLCStyle.fontHeight_normal + VLCStyle.margin_xsmall * 2, VLCStyle.dp(30, VLCStyle.scale))
+                radius: VLCStyle.radiusFor(VLCStyle.dp(4, VLCStyle.scale), true)
+                color: ListView.isCurrentItem ? Qt.alpha(theme.accent, 0.22) : "transparent"
+
+                Text {
+                    anchors.left: parent.left
+                    anchors.leftMargin: VLCStyle.margin_xsmall
+                    anchors.right: shortcutText.left
+                    anchors.rightMargin: VLCStyle.margin_xsmall
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: row.modelData.title
+                    textFormat: Text.PlainText
+                    elide: Text.ElideRight
+                    color: theme.fg.primary
+                    font.pixelSize: VLCStyle.fontSize_normal
+                }
+
+                Text {
+                    id: shortcutText
+
+                    anchors.right: parent.right
+                    anchors.rightMargin: VLCStyle.margin_xsmall
+                    anchors.verticalCenter: parent.verticalCenter
+                    width: Math.min(implicitWidth, row.width * 0.4)
+                    text: row.modelData.shortcut
+                    textFormat: Text.PlainText
+                    elide: Text.ElideRight
+                    horizontalAlignment: Text.AlignRight
+                    color: theme.fg.secondary
+                    font.pixelSize: VLCStyle.fontSize_small
+                }
+
+                MouseArea {
+                    anchors.fill: parent
+                    hoverEnabled: true
+                    onEntered: list.currentIndex = row.index
+                    onClicked: root.runEntry(row.modelData)
+                }
+            }
+
+            Text {
+                anchors.centerIn: parent
+                visible: list.count === 0
+                text: qsTr("No matching command")
+                textFormat: Text.PlainText
+                color: theme.fg.secondary
+                font.pixelSize: VLCStyle.fontSize_normal
+            }
+        }
+    }
+}
