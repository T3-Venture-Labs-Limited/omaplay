@@ -0,0 +1,50 @@
+/*****************************************************************************
+ * hotkey_actions.hpp : VLC's hotkey actions, listed and runnable by name
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#ifndef HOTKEY_ACTIONS_HPP
+#define HOTKEY_ACTIONS_HPP
+
+#include <QObject>
+#include <QVariantList>
+
+struct qt_intf_t;
+
+/**
+ * Every hotkey action VLC knows (play/pause, seek, subtitle delay, ...), with its label and the keys
+ * currently bound to it. The command palette lists them and the shortcut overlay shows them; running
+ * one goes through the same `key-action` variable a key press ends in, so it behaves exactly like
+ * pressing the key.
+ */
+class HotkeyActions : public QObject
+{
+    Q_OBJECT
+    /// Each entry: { name, title, shortcut }. `shortcut` is empty for an unbound action.
+    Q_PROPERTY(QVariantList actions READ actions NOTIFY changed FINAL)
+
+public:
+    explicit HotkeyActions(qt_intf_t *intf, QObject *parent = nullptr);
+
+    QVariantList actions() const { return m_actions; }
+
+    /// Runs an action by its option name, e.g. "key-play-pause". False if the name is unknown.
+    Q_INVOKABLE bool run(const QString &name);
+    /// Re-reads the bindings, after the user changed them in the preferences.
+    Q_INVOKABLE void refresh();
+    /// Rank of `query` against `text` for the palette, or -1 for no match (see FuzzyMatch::score).
+    Q_INVOKABLE int fuzzyScore(const QString &query, const QString &text) const;
+
+signals:
+    void changed();
+
+private:
+    qt_intf_t *m_intf;
+    QVariantList m_actions;
+};
+
+#endif // HOTKEY_ACTIONS_HPP
