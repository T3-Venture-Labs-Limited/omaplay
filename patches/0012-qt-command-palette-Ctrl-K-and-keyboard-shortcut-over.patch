diff --git a/modules/gui/qt/tests/test_qt_fuzzy_match.cpp b/modules/gui/qt/tests/test_qt_fuzzy_match.cpp
new file mode 100644
index 0000000000..e8e6740572
--- /dev/null
+++ b/modules/gui/qt/tests/test_qt_fuzzy_match.cpp
@@ -0,0 +1,80 @@
+/*****************************************************************************
+ * test_qt_fuzzy_match.cpp : ranking for the command palette
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#include <QTest>
+
+#include "util/fuzzy_match.hpp"
+
+using FuzzyMatch::score;
+
+class TestFuzzyMatch : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void emptyQueryMatchesEverything()
+    {
+        QVERIFY(score("", "Preferences") >= 0);
+        QVERIFY(score("", "") >= 0);
+    }
+
+    void queryMustBeASubsequence()
+    {
+        QVERIFY(score("sync", "Subtitle synchronisation") >= 0);
+        QVERIFY(score("sbtl", "Subtitle track") >= 0);
+        QCOMPARE(score("xyz", "Subtitle synchronisation"), -1);
+        QCOMPARE(score("tilte", "Subtitle"), -1);       // letters in the wrong order
+        QCOMPARE(score("aa", "a"), -1);                 // more query than text
+    }
+
+    void ignoresCase()
+    {
+        QCOMPARE(score("PREFS", "Preferences"), score("prefs", "preferences"));
+        QVERIFY(score("PREFS", "Preferences") >= 0);
+    }
+
+    void aPrefixBeatsAMatchInTheMiddle()
+    {
+        QVERIFY(score("play", "Play / Pause") > score("play", "Display lyrics"));
+    }
+
+    void aWordStartBeatsAMatchInsideAWord()
+    {
+        // "sync" starts the word in the first and sits inside a word in the second.
+        QVERIFY(score("sync", "Subtitle sync") > score("sync", "Asynchronous"));
+    }
+
+    void consecutiveLettersBeatScatteredOnes()
+    {
+        QVERIFY(score("sub", "Subtitle") > score("sub", "Stop unless buffering"));
+    }
+
+    void shorterTextWinsOnAnEqualMatch()
+    {
+        QVERIFY(score("open", "Open file") > score("open", "Open network stream"));
+    }
+
+    void unicodeDoesNotConfuseIt()
+    {
+        QVERIFY(score("cafe", "Café") < 0 || score("cafe", "Café") >= 0);   // must not crash or hang
+        QVERIFY(score("é", "Café") >= 0);
+    }
+
+    void sortingByScorePutsTheBestFirst()
+    {
+        QStringList items = {"Display lyrics", "Play / Pause", "Replay", "Playback speed"};
+        std::stable_sort(items.begin(), items.end(), [](const QString &a, const QString &b) {
+            return score("play", a) > score("play", b);
+        });
+        QCOMPARE(items.first(), QString("Play / Pause"));
+    }
+};
+
+QTEST_GUILESS_MAIN(TestFuzzyMatch)
+#include "test_qt_fuzzy_match.moc"
diff --git a/modules/gui/qt/util/fuzzy_match.cpp b/modules/gui/qt/util/fuzzy_match.cpp
new file mode 100644
index 0000000000..5a17504c68
--- /dev/null
+++ b/modules/gui/qt/util/fuzzy_match.cpp
@@ -0,0 +1,84 @@
+/*****************************************************************************
+ * fuzzy_match.cpp : ranking for the command palette
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#include "fuzzy_match.hpp"
+
+#include <QVector>
+#include <algorithm>
+#include <limits>
+
+namespace {
+constexpr int Base = 10;           // every matched letter
+constexpr int WordStart = 80;      // the letter starts a word
+constexpr int TextStart = 60;      // ... and it is the very first letter of the text
+constexpr int Consecutive = 60;    // directly after the previous matched letter
+constexpr int GapPenalty = 10;     // per skipped letter between two matches
+constexpr int LeadPenalty = 5;     // per skipped letter before the first match
+constexpr int LeadPenaltyMax = 30;
+constexpr int NoMatch = std::numeric_limits<int>::min() / 2;
+
+bool startsWord(const QString &t, int j)
+{
+    return j == 0 || !t.at(j - 1).isLetterOrNumber();
+}
+} // namespace
+
+int FuzzyMatch::score(const QString &queryIn, const QString &textIn)
+{
+    const QString query = queryIn.trimmed().toCaseFolded();
+    const QString text = textIn.toCaseFolded();
+    const int n = query.size(), m = text.size();
+    if (n == 0)
+        return 0;
+    if (n > m)
+        return -1;
+
+    // best[i][j]: the best score with query[i] matched at text[j].
+    QVector<QVector<int>> best(n, QVector<int>(m, NoMatch));
+    for (int i = 0; i < n; ++i) {
+        // Running best of the previous row over positions before j, discounted by the gap.
+        int carry = NoMatch;
+        for (int j = 0; j < m; ++j) {
+            if (i > 0 && j > 0) {
+                // Extend a match that ended earlier: each skipped letter costs GapPenalty.
+                const int prev = best[i - 1][j - 1];
+                if (carry != NoMatch)
+                    carry -= GapPenalty;
+                if (prev != NoMatch)
+                    carry = std::max(carry, prev);
+            }
+            if (text.at(j) != query.at(i))
+                continue;
+
+            int bonus = Base;
+            if (startsWord(textIn, j))
+                bonus += WordStart + (j == 0 ? TextStart : 0);
+
+            if (i == 0) {
+                best[i][j] = bonus - std::min(LeadPenaltyMax, j * LeadPenalty);
+            } else if (j > 0) {
+                int via = NoMatch;
+                if (best[i - 1][j - 1] != NoMatch)
+                    via = best[i - 1][j - 1] + Consecutive;           // directly after the last match
+                if (carry != NoMatch)
+                    via = std::max(via, carry);                       // after a gap
+                if (via != NoMatch)
+                    best[i][j] = via + bonus;
+            }
+        }
+    }
+
+    int top = NoMatch;
+    for (int j = 0; j < m; ++j)
+        top = std::max(top, best[n - 1][j]);
+    if (top == NoMatch)
+        return -1;
+    // Shorter texts win a tie; a match never scores below zero, which is reserved for "no match".
+    return std::max(0, top - m);
+}
diff --git a/modules/gui/qt/util/fuzzy_match.hpp b/modules/gui/qt/util/fuzzy_match.hpp
new file mode 100644
index 0000000000..ed78c90f61
--- /dev/null
+++ b/modules/gui/qt/util/fuzzy_match.hpp
@@ -0,0 +1,29 @@
+/*****************************************************************************
+ * fuzzy_match.hpp : ranking for the command palette
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#ifndef FUZZY_MATCH_HPP
+#define FUZZY_MATCH_HPP
+
+#include <QString>
+
+namespace FuzzyMatch {
+
+/**
+ * How well `query` matches `text`, or -1 when it does not match at all.
+ *
+ * The query must appear in the text as a subsequence, ignoring case. Among the possible alignments
+ * the best one is scored: letters that start a word or the whole text, and letters that follow the
+ * previous match directly, score high; gaps cost a little; shorter texts win a tie. An empty query
+ * matches everything with score 0.
+ */
+int score(const QString &query, const QString &text);
+
+} // namespace FuzzyMatch
+
+#endif // FUZZY_MATCH_HPP
