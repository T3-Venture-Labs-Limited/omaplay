@@ -0,0 +1,80 @@
+/*****************************************************************************
+ * hotkey_actions.cpp : VLC's hotkey actions, listed and runnable by name
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include "hotkey_actions.hpp"
+#include "fuzzy_match.hpp"
+
+#include "qt.hpp"
+
+#include <vlc_actions.h>
+#include <vlc_modules.h>
+#include <vlc_plugin.h>
+
+#include <QVariantMap>
+
+HotkeyActions::HotkeyActions(qt_intf_t *intf, QObject *parent)
+    : QObject(parent)
+    , m_intf(intf)
+{
+    refresh();
+}
+
+void HotkeyActions::refresh()
+{
+    QVariantList list;
+
+    module_t *main = module_get_main();
+    unsigned count = 0;
+    module_config_t *config = main ? module_config_get(main, &count) : nullptr;
+    for (unsigned i = 0; i < count; ++i) {
+        const module_config_t &item = config[i];
+        if (item.i_type != CONFIG_ITEM_KEY || !item.psz_name)
+            continue;
+        // "global-key-..." are desktop-wide duplicates of the same actions.
+        if (strncmp(item.psz_name, "global-", 7) == 0)
+            continue;
+
+        // The live binding, which the preferences may have changed since start-up.
+        char *keys = config_GetPsz(item.psz_name);
+        QString shortcut = keys ? qfu(keys) : QString();
+        free(keys);
+        shortcut.replace(QLatin1Char('\t'), QStringLiteral(" / "));
+        if (shortcut == QStringLiteral("Unset"))
+            shortcut.clear();
+
+        list << QVariantMap{
+            {"name", qfu(item.psz_name)},
+            {"title", qfut(item.psz_text ? item.psz_text : item.psz_name)},
+            {"shortcut", shortcut},
+        };
+    }
+    module_config_free(config);
+
+    m_actions = list;
+    emit changed();
+}
+
+bool HotkeyActions::run(const QString &name)
+{
+    const QByteArray utf8 = name.toUtf8();
+    const vlc_action_id_t id = vlc_actions_get_id(utf8.constData());
+    if (id == ACTIONID_NONE)
+        return false;
+    var_SetInteger(vlc_object_instance(m_intf), "key-action", id);
+    return true;
+}
+
+int HotkeyActions::fuzzyScore(const QString &query, const QString &text) const
+{
+    return FuzzyMatch::score(query, text);
+}
diff --git a/modules/gui/qt/util/hotkey_actions.hpp b/modules/gui/qt/util/hotkey_actions.hpp
