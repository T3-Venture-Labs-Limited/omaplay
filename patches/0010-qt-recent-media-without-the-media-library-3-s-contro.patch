+/*****************************************************************************
+ * test_qt_recent_media.cpp : the recently opened media history
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#include <QTest>
+#include <QSignalSpy>
+#include <QSettings>
+#include <QTemporaryDir>
+
+#include "util/recent_media.hpp"
+
+class TestRecentMedia : public QObject
+{
+    Q_OBJECT
+
+    QString iniPath() const { return m_dir.filePath("test.ini"); }
+
+private slots:
+    void init() { QVERIFY(m_dir.isValid()); QFile::remove(iniPath()); }
+
+    void startsEmpty()
+    {
+        QSettings s(iniPath(), QSettings::IniFormat);
+        RecentMediaList list(&s);
+        QVERIFY(list.items().isEmpty());
+    }
+
+    void newestFirstAndDeduplicated()
+    {
+        QSettings s(iniPath(), QSettings::IniFormat);
+        RecentMediaList list(&s);
+        list.add(QUrl("file:///a.mp4"), "A");
+        list.add(QUrl("file:///b.mp4"), "B");
+        list.add(QUrl("file:///a.mp4"), "A again");   // moves to the front, does not duplicate
+        const auto items = list.items();
+        QCOMPARE(items.size(), 2);
+        QCOMPARE(items[0].toMap()["url"].toString(), QString("file:///a.mp4"));
+        QCOMPARE(items[0].toMap()["title"].toString(), QString("A again"));
+        QCOMPARE(items[1].toMap()["url"].toString(), QString("file:///b.mp4"));
+    }
+
+    void keepsOnlyTheNewestTen()
+    {
+        QSettings s(iniPath(), QSettings::IniFormat);
+        RecentMediaList list(&s);
+        for (int i = 0; i < 12; ++i)
+            list.add(QUrl(QString("file:///%1.mp4").arg(i)), QString::number(i));
+        const auto items = list.items();
+        QCOMPARE(items.size(), RecentMediaList::Limit);
+        QCOMPARE(items.first().toMap()["url"].toString(), QString("file:///11.mp4"));
+        QCOMPARE(items.last().toMap()["url"].toString(), QString("file:///2.mp4"));
+    }
+
+    void persistsAcrossInstances()
+    {
+        {
+            QSettings s(iniPath(), QSettings::IniFormat);
+            RecentMediaList list(&s);
+            list.add(QUrl("https://example.invalid/stream.m3u8"), "Stream");
+            list.add(QUrl("file:///a.mp4"), "A");
+        }
+        QSettings s(iniPath(), QSettings::IniFormat);
+        RecentMediaList again(&s);
+        const auto items = again.items();
+        QCOMPARE(items.size(), 2);
+        QCOMPARE(items[0].toMap()["url"].toString(), QString("file:///a.mp4"));
+        QCOMPARE(items[1].toMap()["title"].toString(), QString("Stream"));
+    }
+
+    void ignoresEmptyUrls()
+    {
+        QSettings s(iniPath(), QSettings::IniFormat);
+        RecentMediaList list(&s);
+        list.add(QUrl(), "nothing");
+        QVERIFY(list.items().isEmpty());
+    }
+
+    void titleCanBeFilledInLater()
+    {
+        QSettings s(iniPath(), QSettings::IniFormat);
+        RecentMediaList list(&s);
+        list.add(QUrl("file:///a.mp4"), QString());          // the name is not known yet
+        list.setTitle(QUrl("file:///a.mp4"), "Real title");
+        list.setTitle(QUrl("file:///unknown.mp4"), "ignored");
+        QCOMPARE(list.items().size(), 1);
+        QCOMPARE(list.items()[0].toMap()["title"].toString(), QString("Real title"));
+    }
+
+    void emptyTitleFallsBackToTheFileName()
+    {
+        QSettings s(iniPath(), QSettings::IniFormat);
+        RecentMediaList list(&s);
+        list.add(QUrl("file:///home/me/My%20Film.mkv"), QString());
+        QCOMPARE(list.items()[0].toMap()["display"].toString(), QString("My Film.mkv"));
+    }
+
+    void notifiesOnlyWhenSomethingChanged()
+    {
+        QSettings s(iniPath(), QSettings::IniFormat);
+        RecentMediaList list(&s);
+        QSignalSpy spy(&list, &RecentMediaList::changed);
+        list.add(QUrl("file:///a.mp4"), "A");
+        QCOMPARE(spy.count(), 1);
+        list.add(QUrl("file:///a.mp4"), "A");                // already first and identical
+        QCOMPARE(spy.count(), 1);
+        list.clear();
+        QCOMPARE(spy.count(), 2);
+        list.clear();                                        // already empty
+        QCOMPARE(spy.count(), 2);
+    }
+
+private:
+    QTemporaryDir m_dir;
+};
+
+QTEST_GUILESS_MAIN(TestRecentMedia)
+#include "test_qt_recent_media.moc"
diff --git a/modules/gui/qt/util/recent_media.cpp b/modules/gui/qt/util/recent_media.cpp
new file mode 100644
index 0000000000..fb46a25a05
--- /dev/null
+++ b/modules/gui/qt/util/recent_media.cpp
@@ -0,0 +1,120 @@
+/*****************************************************************************
+ * recent_media.cpp : recently opened media, independent of the media library
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#include "recent_media.hpp"
+
+#include <QSettings>
+#include <QVariantMap>
+
+namespace {
+const QString group = QStringLiteral("RecentMedia");
+
+QString displayName(const QString &url, const QString &title)
+{
+    if (!title.isEmpty())
+        return title;
+    // Untitled: show the last path component, decoded, as a file manager would.
+    const QUrl u(url);
+    const QString name = u.fileName();
+    return name.isEmpty() ? url : name;
+}
+} // namespace
+
+RecentMediaList::RecentMediaList(QSettings *settings, QObject *parent)
+    : QObject(parent)
+    , m_settings(settings)
+{
+    load();
+}
+
+void RecentMediaList::load()
+{
+    m_entries.clear();
+    const int n = m_settings->beginReadArray(group);
+    for (int i = 0; i < n && i < Limit; ++i) {
+        m_settings->setArrayIndex(i);
+        const QString url = m_settings->value(QStringLiteral("url")).toString();
+        if (!url.isEmpty())
+            m_entries.append({url, m_settings->value(QStringLiteral("title")).toString()});
+    }
+    m_settings->endArray();
+}
+
+void RecentMediaList::save() const
+{
+    m_settings->beginWriteArray(group, m_entries.size());
+    for (int i = 0; i < m_entries.size(); ++i) {
+        m_settings->setArrayIndex(i);
+        m_settings->setValue(QStringLiteral("url"), m_entries[i].url);
+        m_settings->setValue(QStringLiteral("title"), m_entries[i].title);
+    }
+    m_settings->endArray();
+    m_settings->sync();
+}
+
+QVariantList RecentMediaList::items() const
+{
+    QVariantList out;
+    for (const Entry &e : m_entries)
+        out << QVariantMap{{"url", e.url}, {"title", e.title}, {"display", displayName(e.url, e.title)}};
+    return out;
+}
+
+void RecentMediaList::add(const QUrl &url, const QString &title)
+{
+    if (!url.isValid() || url.isEmpty())
+        return;
+    const QString u = url.toString(QUrl::FullyEncoded);
+
+    // Already first and identical: nothing to change, nothing to repaint.
+    if (!m_entries.isEmpty() && m_entries.first().url == u
+        && (title.isEmpty() || m_entries.first().title == title))
+        return;
+
+    // Keep a title we already know when the same media is opened before its name is available.
+    QString keptTitle = title;
+    for (int i = 0; i < m_entries.size(); ++i)
+        if (m_entries[i].url == u) {
+            if (keptTitle.isEmpty())
+                keptTitle = m_entries[i].title;
+            m_entries.removeAt(i);
+            break;
+        }
+
+    m_entries.prepend({u, keptTitle});
+    while (m_entries.size() > Limit)
+        m_entries.removeLast();
+    save();
+    emit changed();
+}
+
+void RecentMediaList::setTitle(const QUrl &url, const QString &title)
+{
+    if (title.isEmpty())
+        return;
+    const QString u = url.toString(QUrl::FullyEncoded);
+    for (Entry &e : m_entries)
+        if (e.url == u) {
+            if (e.title == title)
+                return;
+            e.title = title;
+            save();
+            emit changed();
+            return;
+        }
+}
+
+void RecentMediaList::clear()
+{
+    if (m_entries.isEmpty())
+        return;
+    m_entries.clear();
+    save();
+    emit changed();
+}
