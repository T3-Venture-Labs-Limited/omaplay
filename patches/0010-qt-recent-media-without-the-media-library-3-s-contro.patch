+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#ifndef RECENT_MEDIA_HPP
+#define RECENT_MEDIA_HPP
+
+#include <QObject>
+#include <QUrl>
+#include <QVariantList>
+
+class QSettings;
+
+/**
+ * The last few media the user played, newest first, stored in the interface settings.
+ *
+ * VLC 4's own "recent media" is backed by the media library, so without a library there is
+ * none. This list needs nothing but QSettings, so the empty home screen can offer it either way.
+ */
+class RecentMediaList : public QObject
+{
+    Q_OBJECT
+    /// Each entry: { url, title, display }. `display` is the title, or the file name when untitled.
+    Q_PROPERTY(QVariantList items READ items NOTIFY changed FINAL)
+
+public:
+    static constexpr int Limit = 10;
+
+    /// The settings object is not owned and must outlive this list.
+    explicit RecentMediaList(QSettings *settings, QObject *parent = nullptr);
+
+    QVariantList items() const;
+
+public slots:
+    void add(const QUrl &url, const QString &title);
+    /// Fills in the title once the player has learned it. Unknown urls are ignored.
+    void setTitle(const QUrl &url, const QString &title);
+    void clear();
+
+signals:
+    void changed();
+
+private:
+    struct Entry { QString url; QString title; };
+    void load();
+    void save() const;
+
+    QSettings *m_settings;
+    QList<Entry> m_entries;
+};
+
+#endif // RECENT_MEDIA_HPP
