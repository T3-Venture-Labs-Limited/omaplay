+void SystemPalette::restoreStockColors()
+{
+    m_fgOverride = QColor();
+    if (!m_stock)
+        return;
+    orange500 = m_stock->orange500;
+    orange800 = m_stock->orange800;
+    darkGrey200 = m_stock->dark[0]; darkGrey300 = m_stock->dark[1]; darkGrey400 = m_stock->dark[2];
+    darkGrey500 = m_stock->dark[3]; darkGrey600 = m_stock->dark[4]; darkGrey700 = m_stock->dark[5];
+    darkGrey800 = m_stock->dark[6];
+    lightGrey100 = m_stock->light[0]; lightGrey200 = m_stock->light[1]; lightGrey300 = m_stock->light[2];
+    lightGrey400 = m_stock->light[3]; lightGrey500 = m_stock->light[4]; lightGrey600 = m_stock->light[5];
+    lightGrey700 = m_stock->light[6];
+    m_stock.reset();
+}
+
+/**
+ * The Omarchy scheme reuses the stock palettes: it substitutes the theme's colours for the
+ * base colours they are built from, then lets upstream derive every state (hover, pressed,
+ * focused, disabled) as usual. A final pass keeps text readable on whatever surface it sits on.
+ */
+void SystemPalette::makeOmarchyPalette()
+{
+    OmarchyTheme *theme = m_ctx ? m_ctx->omarchyTheme() : nullptr;
+    if (!theme)
+    {
+        // No interface context to find the theme through: behave like the stock dark scheme.
+        makeDarkPalette();
+        return;
+    }
+
+    if (!m_stock)
+    {
+        m_stock = std::make_unique<StockColors>();
+        m_stock->orange500 = orange500;
+        m_stock->orange800 = orange800;
+        const QColor *dark[] = {&darkGrey200, &darkGrey300, &darkGrey400, &darkGrey500, &darkGrey600, &darkGrey700, &darkGrey800};
+        const QColor *light[] = {&lightGrey100, &lightGrey200, &lightGrey300, &lightGrey400, &lightGrey500, &lightGrey600, &lightGrey700};
+        for (int i = 0; i < 7; ++i)
+        {
+            m_stock->dark[i] = *dark[i];
+            m_stock->light[i] = *light[i];
+        }
+    }
+
+    // A theme switch repaints everything. Connect once; the connection is to the theme object,
+    // which MainCtx owns, so it lives as long as this palette can be asked to update.
+    if (!m_omarchyConnection)
+        m_omarchyConnection = connect(theme, &OmarchyTheme::changed, this, &SystemPalette::updatePalette);
+
+    orange500 = theme->accent();
+    orange800 = theme->accent().lighter(150);
+    m_fgOverride = theme->foreground();
+
+    if (theme->isDark())
+    {
+        darkGrey200 = theme->ramp(0); darkGrey300 = theme->ramp(1); darkGrey400 = theme->ramp(2);
+        darkGrey500 = theme->ramp(3); darkGrey600 = theme->ramp(4); darkGrey700 = theme->ramp(5);
+        darkGrey800 = theme->ramp(6);
+        makeDarkPalette();
+    }
+    else
+    {
+        lightGrey100 = theme->ramp(0); lightGrey200 = theme->ramp(1); lightGrey300 = theme->ramp(2);
+        lightGrey400 = theme->ramp(3); lightGrey500 = theme->ramp(4); lightGrey600 = theme->ramp(5);
+        lightGrey700 = theme->ramp(6);
+        makeLightPalette();
+    }
+
+    applyContrastSafety();
+}
+
+void SystemPalette::applyContrastSafety()
+{
+    typedef ColorContext C;
+    constexpr double minRatio = 4.5;
+    static const C::ColorSet sets[] = {C::View, C::Window, C::Item, C::Badge, C::ButtonStandard, C::ButtonAccent,
+                                       C::ToolButton, C::TabButton, C::MenuBar, C::Tooltip, C::Slider,
+                                       C::ComboBox, C::SpinBox, C::TextField, C::Switch};
+    static const C::ColorState states[] = {C::Normal, C::Hovered, C::Pressed, C::Focused};
+    static const C::ColorName names[] = {C::Primary, C::Secondary};
+
+    const auto opaque = [](const QColor &c, const QColor &under) {
+        const double a = c.alphaF();
+        return QColor::fromRgbF(c.redF() * a + under.redF() * (1 - a),
+                                c.greenF() * a + under.greenF() * (1 - a),
+                                c.blueF() * a + under.blueF() * (1 - a));
+    };
+
+    for (const auto set : sets)
+        for (const auto state : states)
+        {
+            const QColor viewBg = getColor(C::View, C::Bg, C::Primary, C::Normal);
+            const QColor bg = opaque(getColor(set, C::Bg, C::Primary, state), viewBg);
+            for (const auto name : names)
+            {
+                const QColor fg = opaque(getColor(set, C::Fg, name, state), bg);
+                if (OmarchyTheme::contrastRatio(fg, bg) < minRatio)
+                    setColor(set, C::Fg, name, state, OmarchyTheme::ensureContrast(fg, bg, minRatio));
+            }
+        }
+}
