+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include <QTest>
+#include <QSignalSpy>
+
+#include "util/color_scheme_model.hpp"
+
+class TestColorSchemeModel : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void listsTheStockSchemesAndOmarchy()
+    {
+        ColorSchemeModel model;
+        QCOMPARE(model.rowCount(QModelIndex()), 4);
+
+        QStringList names;
+        for (const auto &item : model.getSchemes())
+            names << item.text;
+        QVERIFY(names.contains("System"));
+        QVERIFY(names.contains("Day"));
+        QVERIFY(names.contains("Night"));
+        QVERIFY(names.contains("Omarchy"));
+    }
+
+    void stockSchemesKeepTheirIndices()
+    {
+        // The first-run wizard writes the indices 0..2 for System, Day and Night.
+        ColorSchemeModel model;
+        model.setCurrentIndex(0);
+        QCOMPARE(model.currentScheme(), ColorSchemeModel::System);
+        model.setCurrentIndex(1);
+        QCOMPARE(model.currentScheme(), ColorSchemeModel::Day);
+        model.setCurrentIndex(2);
+        QCOMPARE(model.currentScheme(), ColorSchemeModel::Night);
+        model.setCurrentIndex(3);
+        QCOMPARE(model.currentScheme(), ColorSchemeModel::Omarchy);
+    }
+
+    void defaultFollowsTheBuildOption()
+    {
+        ColorSchemeModel model;
+#if VLC_OMARCHY_DEFAULT
+        QCOMPARE(model.currentScheme(), ColorSchemeModel::Omarchy);
+#else
+        QCOMPARE(model.currentScheme(), ColorSchemeModel::System);
+#endif
+    }
+
+    void selectingASchemeNotifies()
+    {
+        ColorSchemeModel model;
+        QSignalSpy spy(&model, &ColorSchemeModel::currentChanged);
+        model.setCurrentIndex(2);
+        QCOMPARE(spy.count(), 1);
+        model.setCurrentIndex(2);       // no change, no notification
+        QCOMPARE(spy.count(), 1);
+    }
+};
+
+QTEST_GUILESS_MAIN(TestColorSchemeModel)
+#include "test_qt_color_scheme_model.moc"
