+OmarchyTheme *MainCtx::omarchyTheme()
+{
+    if (!m_omarchyTheme)
+    {
+        m_omarchyTheme = new OmarchyTheme(OmarchyTheme::defaultPath(), this);
+        // One warning per start-up, e.g. when the theme file does not exist.
+        for (const QString &warning : m_omarchyTheme->warnings())
+            msg_Warn(p_intf, "%s", qtu(warning));
+        // A theme switch changes the light/dark hint that QtWidgets dialogs follow.
+        connect(m_omarchyTheme, &OmarchyTheme::changed, this, &MainCtx::applyQtColorScheme);
+    }
+    return m_omarchyTheme;
+}
+
+void MainCtx::applyQtColorScheme()
+{
+    QStyleHints *const styleHints = qGuiApp->styleHints();
+    if (unlikely(!styleHints))
+        return;
+
+    Qt::ColorScheme scheme;
+    switch (m_colorScheme->currentScheme())
+    {
+    case ColorSchemeModel::ColorScheme::Day:
+        scheme = Qt::ColorScheme::Light;
+        break;
+    case ColorSchemeModel::ColorScheme::Night:
+        scheme = Qt::ColorScheme::Dark;
+        break;
+    case ColorSchemeModel::ColorScheme::Omarchy:
+        scheme = omarchyTheme()->isDark() ? Qt::ColorScheme::Dark : Qt::ColorScheme::Light;
+        break;
+    case ColorSchemeModel::ColorScheme::System:
+    default:
+        styleHints->unsetColorScheme();
+        return;
+    }
+
+    styleHints->setColorScheme(scheme);
+}
