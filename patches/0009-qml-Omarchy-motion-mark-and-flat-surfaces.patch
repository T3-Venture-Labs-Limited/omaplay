diff --git a/modules/gui/qt/maininterface/mainctx.cpp b/modules/gui/qt/maininterface/mainctx.cpp
index 3b192261d9..0b67e5272f 100644
--- a/modules/gui/qt/maininterface/mainctx.cpp
+++ b/modules/gui/qt/maininterface/mainctx.cpp
@@ -368,16 +368,31 @@ bool MainCtx::hasVLM() const {
 #endif
 }
 
+bool MainCtx::omarchyStyle() const
+{
+    return VLC_OMARCHY_DEFAULT;
+}
+
+bool MainCtx::omarchyAnimations()
+{
+#if VLC_OMARCHY_DEFAULT
+    return omarchyTheme()->animationsEnabled();
+#else
+    return true;
+#endif
+}
+
 OmarchyTheme *MainCtx::omarchyTheme()
 {
     if (!m_omarchyTheme)
     {
-        m_omarchyTheme = new OmarchyTheme(OmarchyTheme::defaultPath(), this);
+        m_omarchyTheme = new OmarchyTheme(OmarchyTheme::defaultPath(), OmarchyTheme::defaultNoAnimationsFlag(), this);
         // One warning per start-up, e.g. when the theme file does not exist.
         for (const QString &warning : m_omarchyTheme->warnings())
             msg_Warn(p_intf, "%s", qtu(warning));
         // A theme switch changes the light/dark hint that QtWidgets dialogs follow.
         connect(m_omarchyTheme, &OmarchyTheme::changed, this, &MainCtx::applyQtColorScheme);
+        connect(m_omarchyTheme, &OmarchyTheme::animationsChanged, this, &MainCtx::omarchyAnimationsChanged);
     }
     return m_omarchyTheme;
 }
