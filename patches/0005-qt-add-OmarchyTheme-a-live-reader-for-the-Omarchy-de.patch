+/*****************************************************************************
+ * omarchytheme.hpp : reads the active Omarchy desktop theme
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#ifndef OMARCHYTHEME_HPP
+#define OMARCHYTHEME_HPP
+
+#include <QObject>
+#include <QColor>
+#include <QString>
+#include <QStringList>
+#include <QTimer>
+
+class QFileSystemWatcher;
+
+/**
+ * The colours of the active Omarchy theme, read from its colors.toml, with a
+ * built-in dark fallback and live updates.
+ *
+ * Omarchy switches theme by replacing files, directories and symlinks under
+ * ~/.local/state/omarchy/current, so a plain file watch would stop working after
+ * the first switch. The watches are therefore re-armed after every change.
+ *
+ * This class deliberately depends on Qt only, so it can be unit tested alone.
+ */
+class OmarchyTheme : public QObject
+{
+    Q_OBJECT
+
+public:
+    /// Number of steps in the background ramp (matches VLC's darkGrey200..800).
+    static constexpr int RampSteps = 7;
+
+    explicit OmarchyTheme(const QString &colorsPath = defaultPath(), QObject *parent = nullptr);
+
+    /// $XDG_STATE_HOME/omarchy/current/theme/colors.toml
+    static QString defaultPath();
+
+    const QString &path() const { return m_path; }
+    /// False when the file is missing or unreadable and the fallback is in use.
+    bool found() const { return m_found; }
+    bool isDark() const { return m_dark; }
+    /// Problems found while reading, one entry per problem. Empty when the file is clean.
+    const QStringList &warnings() const { return m_warnings; }
+
+    QColor accent() const { return m_accent; }
+    QColor selection() const { return m_selection; }
+    QColor muted() const { return m_muted; }
+    QColor background() const { return m_background; }
+    QColor foreground() const { return m_foreground; }
+    QColor brightForeground() const { return m_brightForeground; }
+
+    /**
+     * Background ramp, step 0 .. RampSteps-1. In a dark theme it starts at the
+     * darkest background and gets lighter; in a light theme it starts at the
+     * lightest and gets darker.
+     */
+    QColor ramp(int step) const;
+
+    /// WCAG contrast ratio between two opaque colours, 1 .. 21.
+    static double contrastRatio(const QColor &a, const QColor &b);
+    /// Moves fg towards white or black, whichever side of bg is readable, until
+    /// the ratio against bg reaches minRatio. Returns fg unchanged if it already does.
+    static QColor ensureContrast(const QColor &fg, const QColor &bg, double minRatio = 4.5);
+
+signals:
+    /// The theme's colours differ from what they were before the last reload.
+    void changed();
+
+private slots:
+    void onFsEvent();
+    void reload();
+
+private:
+    void applyDefaults();
+    void parse(const QByteArray &data);
+    void rearmWatcher();
+    bool sameColoursAs(const OmarchyTheme &other) const;
+
+    QString m_path;
+    QFileSystemWatcher *m_watcher = nullptr;
+    QTimer m_debounce;
+
+    bool m_found = false;
+    bool m_dark = true;
+    QStringList m_warnings;
+
+    QColor m_accent, m_selection, m_muted;
+    QColor m_background, m_darkBackground, m_darkerBackground, m_lighterBackground;
+    QColor m_foreground, m_brightForeground;
+};
+
+#endif // OMARCHYTHEME_HPP
diff --git a/modules/gui/qt/tests/test_qt_omarchytheme.cpp b/modules/gui/qt/tests/test_qt_omarchytheme.cpp
