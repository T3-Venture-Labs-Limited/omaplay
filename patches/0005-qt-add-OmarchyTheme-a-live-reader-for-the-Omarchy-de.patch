@@ -0,0 +1,261 @@
+/*****************************************************************************
+ * test_qt_omarchytheme.cpp : tests for the Omarchy theme reader
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#include <QTest>
+#include <QSignalSpy>
+#include <QTemporaryDir>
+#include <QFile>
+#include <QDir>
+
+#include "style/omarchytheme.hpp"
+
+namespace {
+
+const char *darkToml = R"(mode = "dark"
+
+accent = "#798186"
+selection = "#343d41"
+muted = "#4b4e55"
+
+background = "#101315"
+dark_background = "#0c0e10"
+darker_background = "#080a0b"
+lighter_background = "#181c1f"
+
+foreground = "#cacccc"
+bright_foreground = "#a5aeb4"
+)";
+
+const char *lightToml = R"(mode = "light"
+accent = "#3b5bdb"
+background = "#fafafa"
+darker_background = "#ececec"
+foreground = "#222222"
+)";
+
+bool writeFile(const QString &path, const QByteArray &data)
+{
+    QFile f(path);
+    if (!f.open(QIODevice::WriteOnly | QIODevice::Truncate))
+        return false;
+    return f.write(data) == data.size();
+}
+
+} // namespace
+
+class TestOmarchyTheme : public QObject
+{
+    Q_OBJECT
+
+    // Nested so the three nearest existing ancestors of the file are all inside the fixture;
+    // otherwise unrelated activity in /tmp would trigger reloads and hide missing re-arming.
+    QString root() const { return m_dir.filePath("state/omarchy"); }
+    QString colorsPath() const { return root() + "/current/theme/colors.toml"; }
+
+    void install(const char *toml)
+    {
+        QVERIFY(QDir().mkpath(root() + "/current/theme"));
+        QVERIFY(writeFile(colorsPath(), toml));
+    }
+
+private slots:
+    void init() { QVERIFY(m_dir.isValid()); QDir(m_dir.path()).removeRecursively(); QVERIFY(QDir().mkpath(root())); }
+
+    void parsesDarkTheme()
+    {
+        install(darkToml);
+        OmarchyTheme theme(colorsPath());
+        QVERIFY(theme.found());
+        QVERIFY(theme.isDark());
+        QCOMPARE(theme.accent(), QColor("#798186"));
+        QCOMPARE(theme.background(), QColor("#101315"));
+        QCOMPARE(theme.foreground(), QColor("#cacccc"));
+        QCOMPARE(theme.selection(), QColor("#343d41"));
+        QVERIFY(theme.warnings().isEmpty());
+    }
+
+    void parsesLightTheme()
+    {
+        install(lightToml);
+        OmarchyTheme theme(colorsPath());
+        QVERIFY(theme.found());
+        QVERIFY(!theme.isDark());
+        QCOMPARE(theme.accent(), QColor("#3b5bdb"));
+        QCOMPARE(theme.background(), QColor("#fafafa"));
+    }
+
+    void infersModeFromBackgroundWhenMissing()
+    {
+        install("background = \"#f0f0f0\"\nforeground = \"#101010\"\n");
+        OmarchyTheme light(colorsPath());
+        QVERIFY(!light.isDark());
+
+        install("background = \"#101010\"\nforeground = \"#f0f0f0\"\n");
+        OmarchyTheme dark(colorsPath());
+        QVERIFY(dark.isDark());
+    }
+
+    void missingFileFallsBackToBuiltInDarkWithOneWarning()
+    {
+        const QString path = root() + "/nowhere/colors.toml";
+        OmarchyTheme theme(path);
+        QVERIFY(!theme.found());
+        QVERIFY(theme.isDark());
+        QCOMPARE(theme.accent(), QColor("#FFD60A"));
+        QCOMPARE(theme.warnings().size(), 1);
+        QVERIFY(theme.warnings().first().contains(path));
+    }
+
+    void malformedAccentFallsBackButOtherKeysApply()
+    {
+        install("mode = \"dark\"\naccent = \"not-a-colour\"\nbackground = \"#202020\"\nforeground = \"#dddddd\"\n");
+        OmarchyTheme theme(colorsPath());
+        QVERIFY(theme.found());
+        QCOMPARE(theme.accent(), QColor("#FFD60A"));
+        QCOMPARE(theme.background(), QColor("#202020"));
+        QCOMPARE(theme.foreground(), QColor("#dddddd"));
+        QVERIFY(!theme.warnings().isEmpty());
+    }
+
+    void ignoresCommentsSectionsAndUnknownKeys()
+    {
+        install("# comment\n[section]\nfuture_key = \"#123456\"\nmode = \"dark\"\n  accent   =   \"#abcdef\"   # trailing\n");
+        OmarchyTheme theme(colorsPath());
+        QCOMPARE(theme.accent(), QColor("#abcdef"));
+    }
+
+    void backgroundRampGetsMonotonicallyLighterInDarkMode()
+    {
+        install(darkToml);
+        OmarchyTheme theme(colorsPath());
+        for (int i = 1; i < OmarchyTheme::RampSteps; ++i)
+            QVERIFY2(theme.ramp(i).lightnessF() > theme.ramp(i - 1).lightnessF(),
+                     qPrintable(QString("step %1").arg(i)));
+        // The first step is the theme's darkest background.
+        QCOMPARE(theme.ramp(0), QColor("#080a0b"));
+    }
+
+    void backgroundRampGetsMonotonicallyDarkerInLightMode()
+    {
+        install(lightToml);
+        OmarchyTheme theme(colorsPath());
+        for (int i = 1; i < OmarchyTheme::RampSteps; ++i)
+            QVERIFY(theme.ramp(i).lightnessF() < theme.ramp(i - 1).lightnessF());
+        QCOMPARE(theme.ramp(0), QColor("#fafafa"));
+    }
+
+    void contrastRatioMatchesWcagReferenceValues()
+    {
+        QVERIFY(qAbs(OmarchyTheme::contrastRatio(Qt::black, Qt::white) - 21.0) < 0.01);
+        QVERIFY(qAbs(OmarchyTheme::contrastRatio(Qt::white, Qt::white) - 1.0) < 0.01);
+        // #777 on white is the well known 4.48:1 example.
+        QVERIFY(qAbs(OmarchyTheme::contrastRatio(QColor("#777777"), Qt::white) - 4.48) < 0.02);
+    }
+
+    void ensureContrastLeavesGoodColoursAlone()
+    {
+        const QColor fg("#ffffff"), bg("#101315");
+        QCOMPARE(OmarchyTheme::ensureContrast(fg, bg), fg);
+    }
+
+    void ensureContrastFixesLowContrastOnDarkAndLight()
+    {
+        const QColor darkBg("#808080");
+        const QColor fixedOnDark = OmarchyTheme::ensureContrast(QColor("#8a8a8a"), darkBg);
+        QVERIFY(OmarchyTheme::contrastRatio(fixedOnDark, darkBg) >= 4.5);
+
+        const QColor lightBg("#f2f2f2");
+        const QColor fixedOnLight = OmarchyTheme::ensureContrast(QColor("#dddddd"), lightBg);
+        QVERIFY(OmarchyTheme::contrastRatio(fixedOnLight, lightBg) >= 4.5);
+        // The fix goes towards the readable side, not across the whole range.
+        QVERIFY(fixedOnLight.lightnessF() < 0.6);
+    }
+
+    void reloadsWhenFileIsEditedInPlace()
+    {
+        install(darkToml);
+        OmarchyTheme theme(colorsPath());
+        QSignalSpy spy(&theme, &OmarchyTheme::changed);
+        QVERIFY(writeFile(colorsPath(), "mode = \"dark\"\naccent = \"#ff0000\"\n"));
+        QTRY_VERIFY_WITH_TIMEOUT(spy.count() >= 1, 3000);
+        QCOMPARE(theme.accent(), QColor("#ff0000"));
+    }
+
+    void keepsWatchingAfterTheFileIsReplacedTwice()
+    {
+        install(darkToml);
+        OmarchyTheme theme(colorsPath());
+        QSignalSpy spy(&theme, &OmarchyTheme::changed);
+
+        for (const char *accent : {"#00ff00", "#0000ff"}) {
+            const QString tmp = colorsPath() + ".new";
+            QVERIFY(writeFile(tmp, QByteArray("mode = \"dark\"\naccent = \"") + accent + "\"\n"));
+            QVERIFY(QFile::remove(colorsPath()));
+            QVERIFY(QFile::rename(tmp, colorsPath()));
+            const int before = spy.count();
+            QTRY_VERIFY_WITH_TIMEOUT(spy.count() > before, 3000);
+            QCOMPARE(theme.accent(), QColor(accent));
+        }
+    }
+
+    void keepsWatchingAfterTheWholeDirectoryIsSwapped()
+    {
+        install(darkToml);
+        OmarchyTheme theme(colorsPath());
+        QSignalSpy spy(&theme, &OmarchyTheme::changed);
+
+        for (const char *accent : {"#112233", "#445566"}) {
+            const QString fresh = root() + "/current/theme.new";
+            QDir(fresh).removeRecursively();
+            QVERIFY(QDir().mkpath(fresh));
+            QVERIFY(writeFile(fresh + "/colors.toml", QByteArray("mode = \"dark\"\naccent = \"") + accent + "\"\n"));
+            QVERIFY(QDir(root() + "/current/theme").removeRecursively());
+            QVERIFY(QDir().rename(fresh, root() + "/current/theme"));
+            const int before = spy.count();
+            QTRY_VERIFY_WITH_TIMEOUT(spy.count() > before, 3000);
+            QCOMPARE(theme.accent(), QColor(accent));
+        }
+    }
+
+    void picksUpAThemeThatAppearsLaterAndKeepsWatchingIt()
+    {
+        // Nothing exists at start-up, as on a machine where Omarchy has not written a theme yet.
+        OmarchyTheme theme(colorsPath());
+        QVERIFY(!theme.found());
+        QSignalSpy spy(&theme, &OmarchyTheme::changed);
+
+        install(darkToml);
+        QTRY_VERIFY_WITH_TIMEOUT(spy.count() >= 1, 3000);
+        QVERIFY(theme.found());
+        QCOMPARE(theme.accent(), QColor("#798186"));
+
+        // Only a re-armed watcher can see an in-place edit of a file that did not exist when it started.
+        const int before = spy.count();
+        QVERIFY(writeFile(colorsPath(), "mode = \"dark\"\naccent = \"#fedcba\"\n"));
+        QTRY_VERIFY_WITH_TIMEOUT(spy.count() > before, 3000);
+        QCOMPARE(theme.accent(), QColor("#fedcba"));
+    }
+
+    void doesNotEmitChangedWhenNothingChanged()
+    {
+        install(darkToml);
+        OmarchyTheme theme(colorsPath());
+        QSignalSpy spy(&theme, &OmarchyTheme::changed);
+        // Re-writing identical content must not repaint the whole interface.
+        QVERIFY(writeFile(colorsPath(), darkToml));
+        QTest::qWait(500);
+        QCOMPARE(spy.count(), 0);
+    }
+
+private:
+    QTemporaryDir m_dir;
+};
+
+QTEST_GUILESS_MAIN(TestOmarchyTheme)
+#include "test_qt_omarchytheme.moc"
