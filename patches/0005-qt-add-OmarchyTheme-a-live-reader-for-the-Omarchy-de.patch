diff --git a/modules/gui/qt/style/omarchytheme.cpp b/modules/gui/qt/style/omarchytheme.cpp
new file mode 100644
index 0000000000..be081fc9bd
--- /dev/null
+++ b/modules/gui/qt/style/omarchytheme.cpp
@@ -0,0 +1,278 @@
+/*****************************************************************************
+ * omarchytheme.cpp : reads the active Omarchy desktop theme
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#include "omarchytheme.hpp"
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QFileSystemWatcher>
+#include <QHash>
+#include <QRegularExpression>
+#include <QStandardPaths>
+#include <QtMath>
+
+namespace {
+
+// Omarchy's own fallback when it is not installed, see the omarchy-app skill.
+const QColor fallbackAccent(0xFF, 0xD6, 0x0A);
+
+// VLC's stock dark palette, used when there is no theme to read.
+const QColor fallbackBackground(0x21, 0x21, 0x21);
+const QColor fallbackForeground(0xFF, 0xFF, 0xFF);
+
+constexpr int debounceMs = 150;
+
+QColor mix(const QColor &a, const QColor &b, double t)
+{
+    return QColor::fromRgbF(a.redF() + (b.redF() - a.redF()) * t,
+                            a.greenF() + (b.greenF() - a.greenF()) * t,
+                            a.blueF() + (b.blueF() - a.blueF()) * t);
+}
+
+double relativeLuminance(const QColor &c)
+{
+    const auto lin = [](double v) {
+        return v <= 0.03928 ? v / 12.92 : qPow((v + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * lin(c.redF()) + 0.7152 * lin(c.greenF()) + 0.0722 * lin(c.blueF());
+}
+
+bool parseHexColor(const QString &text, QColor &out)
+{
+    // Accept only #rgb and #rrggbb; QColor would also take names like "red".
+    static const QRegularExpression re(QStringLiteral("^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"));
+    if (!re.match(text).hasMatch())
+        return false;
+    out = QColor(text);
+    return out.isValid();
+}
+
+} // namespace
+
+QString OmarchyTheme::defaultPath()
+{
+    QString state = qEnvironmentVariable("XDG_STATE_HOME");
+    if (state.isEmpty())
+        state = QDir::homePath() + QStringLiteral("/.local/state");
+    return state + QStringLiteral("/omarchy/current/theme/colors.toml");
+}
+
+OmarchyTheme::OmarchyTheme(const QString &colorsPath, QObject *parent)
+    : QObject(parent)
+    , m_path(colorsPath)
+    , m_watcher(new QFileSystemWatcher(this))
+{
+    m_debounce.setSingleShot(true);
+    m_debounce.setInterval(debounceMs);
+    connect(&m_debounce, &QTimer::timeout, this, &OmarchyTheme::reload);
+    connect(m_watcher, &QFileSystemWatcher::fileChanged, this, &OmarchyTheme::onFsEvent);
+    connect(m_watcher, &QFileSystemWatcher::directoryChanged, this, &OmarchyTheme::onFsEvent);
+
+    applyDefaults();
+    QFile f(m_path);
+    if (f.open(QIODevice::ReadOnly)) {
+        m_found = true;
+        parse(f.readAll());
+    } else {
+        m_warnings << QStringLiteral("Omarchy theme file not found, using the built-in palette: %1").arg(m_path);
+    }
+    rearmWatcher();
+}
+
+void OmarchyTheme::applyDefaults()
+{
+    m_dark = true;
+    m_accent = fallbackAccent;
+    m_background = fallbackBackground;
+    m_foreground = fallbackForeground;
+    m_darkBackground = m_darkerBackground = m_lighterBackground = QColor();
+    m_selection = mix(m_background, m_foreground, 0.15);
+    m_muted = mix(m_background, m_foreground, 0.35);
+    m_brightForeground = m_foreground;
+}
+
+void OmarchyTheme::parse(const QByteArray &data)
+{
+    QHash<QString, QString> values;
+    const auto lines = QString::fromUtf8(data).split(QLatin1Char('\n'));
+    for (QString line : lines) {
+        // Drop a trailing comment. The values we read never contain '#' after the closing quote.
+        const int quoteEnd = line.lastIndexOf(QLatin1Char('"'));
+        const int hash = line.indexOf(QLatin1Char('#'), quoteEnd < 0 ? 0 : quoteEnd);
+        if (hash >= 0 && (quoteEnd >= 0 || line.trimmed().startsWith(QLatin1Char('#'))))
+            line.truncate(hash);
+        line = line.trimmed();
+        if (line.isEmpty() || line.startsWith(QLatin1Char('[')))
+            continue;
+        const int eq = line.indexOf(QLatin1Char('='));
+        if (eq <= 0)
+            continue;
+        QString key = line.left(eq).trimmed();
+        QString value = line.mid(eq + 1).trimmed();
+        if (value.size() >= 2 && value.startsWith(QLatin1Char('"')) && value.endsWith(QLatin1Char('"')))
+            value = value.mid(1, value.size() - 2);
+        values.insert(key, value);
+    }
+
+    const auto readColor = [&](const char *key, QColor &target) {
+        const auto it = values.constFind(QLatin1String(key));
+        if (it == values.cend())
+            return;
+        QColor c;
+        if (parseHexColor(*it, c))
+            target = c;
+        else
+            m_warnings << QStringLiteral("Ignoring invalid colour for '%1': %2").arg(QLatin1String(key), *it);
+    };
+
+    readColor("accent", m_accent);
+    readColor("selection", m_selection);
+    readColor("muted", m_muted);
+    readColor("background", m_background);
+    readColor("dark_background", m_darkBackground);
+    readColor("darker_background", m_darkerBackground);
+    readColor("lighter_background", m_lighterBackground);
+    readColor("foreground", m_foreground);
+    readColor("bright_foreground", m_brightForeground);
+    if (!values.contains(QStringLiteral("bright_foreground")))
+        m_brightForeground = m_foreground;
+
+    const QString mode = values.value(QStringLiteral("mode")).toLower();
+    if (mode == QLatin1String("dark"))
+        m_dark = true;
+    else if (mode == QLatin1String("light"))
+        m_dark = false;
+    else
+        // Without a mode, judge by the background: it is the surface everything else sits on.
+        m_dark = relativeLuminance(m_background) < relativeLuminance(m_foreground);
+}
+
+QColor OmarchyTheme::ramp(int step) const
+{
+    step = qBound(0, step, RampSteps - 1);
+    // Light themes start at their background and darken. Dark themes start at the theme's own
+    // darkest background (or a darkened background when it has none) and lighten. The remaining
+    // steps walk from the base background towards the foreground in fixed steps, which keeps
+    // hover and pressed states (derived by upstream from neighbouring ramp colours) distinct.
+    if (step == 0) {
+        if (!m_dark)
+            return m_background;
+        return m_darkerBackground.isValid() ? m_darkerBackground : mix(m_background, Qt::black, 0.4);
+    }
+
+    const double t = 0.03 * step;
+    return mix(m_background, m_foreground, t);
+}
+
+double OmarchyTheme::contrastRatio(const QColor &a, const QColor &b)
+{
+    const double la = relativeLuminance(a), lb = relativeLuminance(b);
+    const double hi = qMax(la, lb), lo = qMin(la, lb);
+    return (hi + 0.05) / (lo + 0.05);
+}
+
+QColor OmarchyTheme::ensureContrast(const QColor &fg, const QColor &bg, double minRatio)
+{
+    if (contrastRatio(fg, bg) >= minRatio)
+        return fg;
+
+    // Go the way that gives more room: towards white on a dark background, towards black on a light one.
+    const bool towardsWhite = relativeLuminance(bg) < 0.18;
+    const QColor target = towardsWhite ? QColor(Qt::white) : QColor(Qt::black);
+    QColor best = target;
+    for (int i = 1; i <= 100; ++i) {
+        const QColor c = mix(fg, target, i / 100.0);
+        if (contrastRatio(c, bg) >= minRatio) {
+            best = c;
+            break;
+        }
+    }
+    return best;
+}
+
+void OmarchyTheme::onFsEvent()
+{
+    // Several events arrive for one theme switch (remove, create, rename). Handle them once.
+    m_debounce.start();
+}
+
+bool OmarchyTheme::sameColoursAs(const OmarchyTheme &o) const
+{
+    return m_dark == o.m_dark && m_accent == o.m_accent && m_selection == o.m_selection
+        && m_muted == o.m_muted && m_background == o.m_background
+        && m_darkBackground == o.m_darkBackground && m_darkerBackground == o.m_darkerBackground
+        && m_lighterBackground == o.m_lighterBackground && m_foreground == o.m_foreground
+        && m_brightForeground == o.m_brightForeground && m_found == o.m_found;
+}
+
+void OmarchyTheme::reload()
+{
+    // Parse into a scratch object so "nothing changed" can be detected without a repaint.
+    OmarchyTheme fresh(m_path);
+    // The scratch object's watcher and timer die with it.
+    const bool same = sameColoursAs(fresh);
+
+    // The scratch object was the one that logged problems; carry them over either way so
+    // warnings() describes the file as it is now.
+    m_warnings = fresh.m_warnings;
+    rearmWatcher();
+    if (same)
+        return;
+
+    m_found = fresh.m_found;
+    m_dark = fresh.m_dark;
+    m_accent = fresh.m_accent;
+    m_selection = fresh.m_selection;
+    m_muted = fresh.m_muted;
+    m_background = fresh.m_background;
+    m_darkBackground = fresh.m_darkBackground;
+    m_darkerBackground = fresh.m_darkerBackground;
+    m_lighterBackground = fresh.m_lighterBackground;
+    m_foreground = fresh.m_foreground;
+    m_brightForeground = fresh.m_brightForeground;
+    emit changed();
+}
+
+void OmarchyTheme::rearmWatcher()
+{
+    // QFileSystemWatcher forgets a path as soon as it is deleted or replaced, so add everything
+    // again after every event: the file, its directory, and the directories above it that a
+    // switch may replace (.../current/theme and .../current).
+    const QStringList wanted = [&] {
+        QStringList l;
+        const QFileInfo fi(m_path);
+        if (fi.exists())
+            l << fi.absoluteFilePath();
+        // Walk up by path, not with QDir::cdUp(), which refuses to leave a directory that does
+        // not exist yet. Watch the nearest three directories that exist, so a theme that appears
+        // later (or a replaced .../current) is noticed.
+        QString dir = fi.absolutePath();
+        int watched = 0;
+        for (int depth = 0; depth < 8 && watched < 3; ++depth) {
+            if (QFileInfo(dir).isDir()) {
+                l << dir;
+                ++watched;
+            }
+            const QString up = QFileInfo(dir).absolutePath();
+            if (up == dir)
+                break;
+            dir = up;
+        }
+        return l;
+    }();
+
+    const QStringList have = m_watcher->files() + m_watcher->directories();
+    QStringList missing;
+    for (const QString &p : wanted)
+        if (!have.contains(p))
+            missing << p;
+    if (!missing.isEmpty())
+        m_watcher->addPaths(missing);
+}
