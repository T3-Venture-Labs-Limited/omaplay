+QString OmarchyTheme::parseFontFamily(const QByteArray &out)
+{
+    const QString firstLine = QString::fromUtf8(out).split(QLatin1Char('\n')).value(0);
+    return firstLine.split(QLatin1Char(',')).value(0).trimmed();
+}
+
+int OmarchyTheme::parseRounding(const QByteArray &json)
+{
+    const QJsonValue v = QJsonDocument::fromJson(json).object().value(QLatin1String("int"));
+    // Only a whole, non-negative number is a usable radius.
+    if (!v.isDouble() || v.toDouble() < 0 || v.toDouble() != qFloor(v.toDouble()))
+        return -1;
+    return v.toInt();
+}
+
+namespace {
+QByteArray runTool(const QString &program, const QStringList &args)
+{
+    QProcess p;
+    p.start(program, args);
+    if (!p.waitForFinished(1500) || p.exitStatus() != QProcess::NormalExit || p.exitCode() != 0) {
+        p.kill();
+        return {};
+    }
+    return p.readAllStandardOutput();
+}
+} // namespace
+
+QString OmarchyTheme::systemFontFamily()
+{
+    return parseFontFamily(runTool(QStringLiteral("fc-match"), {QStringLiteral("monospace"), QStringLiteral("-f"),
+                                                                 QStringLiteral("%{family}\n")}));
+}
+
+int OmarchyTheme::hyprlandRounding()
+{
+    return parseRounding(runTool(QStringLiteral("hyprctl"), {QStringLiteral("getoption"),
+                                                              QStringLiteral("decoration:rounding"), QStringLiteral("-j")}));
+}
