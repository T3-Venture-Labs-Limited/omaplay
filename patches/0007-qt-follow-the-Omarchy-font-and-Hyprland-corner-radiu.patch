+    void parsesHyprlandRounding()
+    {
+        QCOMPARE(OmarchyTheme::parseRounding(R"({"option": "decoration:rounding", "int": 6, "set": true })"), 6);
+        QCOMPARE(OmarchyTheme::parseRounding(R"({"option": "decoration:rounding", "int": 0, "set": true })"), 0);
