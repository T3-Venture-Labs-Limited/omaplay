+        QCOMPARE(OmarchyTheme::parseRounding(""), -1);
+        QCOMPARE(OmarchyTheme::parseRounding("not json"), -1);
+        QCOMPARE(OmarchyTheme::parseRounding(R"({"option": "decoration:rounding", "float": 1.5})"), -1);
+        QCOMPARE(OmarchyTheme::parseRounding(R"({"int": -3})"), -1);
