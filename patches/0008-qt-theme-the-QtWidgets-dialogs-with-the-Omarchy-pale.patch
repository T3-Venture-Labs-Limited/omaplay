+    void widgetPaletteFollowsTheThemeAndKeepsTextReadable()
+    {
+        QFETCH(QByteArray, toml);
+        install(toml.constData());
+        OmarchyTheme theme(colorsPath());
+        const auto active = theme.widgetPalette(false);
+
+        QCOMPARE(active.value(QPalette::Highlight), theme.accent());
+        QCOMPARE(active.value(QPalette::Accent), theme.accent());
+        QCOMPARE(active.value(QPalette::Window), theme.background());
+
+        const auto ok = [&](QPalette::ColorRole fg, QPalette::ColorRole bg) {
+            const double r = OmarchyTheme::contrastRatio(active.value(fg), active.value(bg));
+            QVERIFY2(r >= 4.5, qPrintable(QString("role %1 on %2: %3").arg(fg).arg(bg).arg(r)));
+        };
+        ok(QPalette::WindowText, QPalette::Window);
+        ok(QPalette::Text, QPalette::Base);
+        ok(QPalette::ButtonText, QPalette::Button);
+        ok(QPalette::HighlightedText, QPalette::Highlight);
+        ok(QPalette::ToolTipText, QPalette::ToolTipBase);
+        ok(QPalette::Link, QPalette::Window);
+        ok(QPalette::PlaceholderText, QPalette::Base);
+    }
+
