+
+/**
+ * QtWidgets dialogs (preferences, effects, media information, ...) do not read the QML palette:
+ * they paint from QApplication's palette. Give them the theme's colours while the Omarchy scheme
+ * is active, and the style's own palette again otherwise. Their layouts are untouched.
+ */
+void MainCtx::applyWidgetPalette()
+{
+    if (m_colorScheme->currentScheme() != ColorSchemeModel::ColorScheme::Omarchy)
+    {
+        if (m_widgetPaletteApplied)
+        {
+            QApplication::setPalette(QApplication::style()->standardPalette());
+            m_widgetPaletteApplied = false;
+        }
+        return;
+    }
+
+    const OmarchyTheme *theme = omarchyTheme();
+    QPalette palette = QApplication::style()->standardPalette();
+    const auto active = theme->widgetPalette(false);
+    const auto disabled = theme->widgetPalette(true);
+    for (auto it = active.cbegin(); it != active.cend(); ++it)
+    {
+        palette.setColor(QPalette::Active, it.key(), it.value());
+        palette.setColor(QPalette::Inactive, it.key(), it.value());
+    }
+    for (auto it = disabled.cbegin(); it != disabled.cend(); ++it)
+        palette.setColor(QPalette::Disabled, it.key(), it.value());
+
+    QApplication::setPalette(palette);
+    m_widgetPaletteApplied = true;
 }
 
