+QHash<QPalette::ColorRole, QColor> OmarchyTheme::widgetPalette(bool disabled) const
+{
+    QHash<QPalette::ColorRole, QColor> p;
+    const QColor window = m_background;
+    // Fields sit one step away from the window so they read as inputs; light themes use a paler
+    // field than the window, dark themes a darker one.
+    const QColor base = m_dark ? ramp(0) : mix(m_background, Qt::white, 0.5);
+    const QColor button = m_dark ? ramp(3) : ramp(2);
+    const QColor tooltip = m_dark ? ramp(4) : base;
+
+    const auto text = [&](const QColor &on, const QColor &also = QColor()) {
+        QColor c = ensureContrast(m_foreground, on);
+        return also.isValid() ? ensureContrast(c, also) : c;
+    };
+    const auto dim = [&](const QColor &c, const QColor &on) { return mix(c, on, 0.55); };
+
+    p[QPalette::Window] = window;
+    p[QPalette::Base] = base;
+    p[QPalette::AlternateBase] = ramp(1);
+    p[QPalette::Button] = button;
+    p[QPalette::ToolTipBase] = tooltip;
+    p[QPalette::Light] = m_dark ? ramp(5) : Qt::white;
+    p[QPalette::Midlight] = m_dark ? ramp(4) : ramp(1);
+    p[QPalette::Mid] = m_dark ? ramp(2) : ramp(4);
+    p[QPalette::Dark] = m_dark ? ramp(0) : ramp(5);
+    p[QPalette::Shadow] = Qt::black;
+
+    QColor winText = text(window, base), btnText = text(button), baseText = text(base), tipText = text(tooltip);
+    QColor placeholder = ensureContrast(mix(m_foreground, base, 0.35), base);
+    if (disabled) {
+        winText = dim(winText, window);
+        btnText = dim(btnText, button);
+        baseText = dim(baseText, base);
+        placeholder = dim(placeholder, base);
+    }
+    p[QPalette::WindowText] = winText;
+    p[QPalette::ButtonText] = btnText;
+    p[QPalette::Text] = baseText;
+    p[QPalette::ToolTipText] = tipText;
+    p[QPalette::PlaceholderText] = placeholder;
+    p[QPalette::BrightText] = m_dark ? Qt::white : Qt::black;
+
+    p[QPalette::Highlight] = m_accent;
+    p[QPalette::Accent] = m_accent;
+    const QColor onAccent = relativeLuminance(m_accent) > 0.4 ? QColor(Qt::black) : QColor(Qt::white);
+    p[QPalette::HighlightedText] = ensureContrast(onAccent, m_accent);
+
+    const QColor link = ensureContrast(m_accent, window);
+    p[QPalette::Link] = link;
+    p[QPalette::LinkVisited] = ensureContrast(mix(link, m_foreground, 0.4), window);
+    return p;
+}
