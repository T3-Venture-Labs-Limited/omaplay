optdepends=('omarchy: live theme following and the omaplay bar widget')
options=('!lto' '!debug')
install=omaplay.install
source=("vlc-$_vlc_commit.tar.gz::https://code.videolan.org/videolan/vlc/-/archive/$_vlc_commit/vlc-$_vlc_commit.tar.gz"
        "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# The second checksum is filled in by `updpkgsums` once the v$pkgver tag exists on GitHub.
sha256sums=('803baccd4f69c606111c46c2f707173fa5b4d1d747da3f986f3d98d2f775f45e'
            'SKIP')

prepare() {
  cd "$srcdir/vlc-$_vlc_commit"
  # git apply, not patch(1): the series carries binary image diffs. Inside another repository (an AUR
  # checkout is one) git apply resolves paths from that repository's root and silently skips the files,
  # so give the source tree its own repository first.
  git init -q .
  local p
  for p in "$srcdir/$pkgname-$pkgver"/patches/*.patch; do
    echo "applying ${p##*/}"
    git apply --whitespace=nowarn "$p"
  done
  # Fail loudly if the series did not land.
  grep -q "option('product_name'" meson_options.txt || { echo "patches were not applied" >&2; return 1; }
}

build() {
  local -a flags
  mapfile -t flags < <("$srcdir/$pkgname-$pkgver/bin/meson-flags")
  meson setup build "vlc-$_vlc_commit" "${flags[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # The binary finds its libraries through RUNPATH and its plugins relative to libvlccore.
  install -dm755 "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/omaplay/bin/vlc "$@"\n' > "$pkgdir/usr/bin/omaplay"
  chmod 755 "$pkgdir/usr/bin/omaplay"

  local src="$srcdir/$pkgname-$pkgver/packaging"
  install -Dm644 "$src/omaplay.desktop" "$pkgdir/usr/share/applications/omaplay.desktop"
  install -Dm644 "$src/omaplay.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaplay.svg"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
