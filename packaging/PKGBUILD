# omaplay is VLC 4 (a pinned development snapshot) with an Omarchy-themed interface. It installs into
# /opt/omaplay and does not conflict with the official vlc package. The changes to VLC are the patch
# series in the omaplay repository, applied to the pinned upstream commit below.

pkgname=omaplay
pkgver=0.1.0
pkgrel=1
_vlc_commit=6b5f85b1d1bb7f4fc0545078338dc040cc3f3d7e
pkgdesc='Omarchy-themed media player based on VLC 4 (experimental, installs beside vlc)'
arch=('x86_64')
url='https://github.com/T3-Venture-Labs-Limited/omaplay'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
